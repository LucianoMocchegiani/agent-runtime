{
  "name": "agent-runtime-api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "start:dev": "tsx watch --env-file=../../.env src/index.ts",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "node --import tsx --test src/agent/window/index.test.ts src/agent/turn/persistence.test.ts src/agent/turn/context.test.ts src/agent/turn/lock.test.ts src/conversations/cursor.test.ts src/agent/tools/tools.test.ts src/preferences/cursor.test.ts src/http/request-body.test.ts src/delegations/payload.test.ts",
    "db:setup": "tsx --env-file=../../.env src/db/setup.ts",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^1.0.78",
    "@ai-sdk/openai": "^3.0.124",
    "@hono/node-server": "^1.19.0",
    "@openrouter/ai-sdk-provider": "^2.10.0",
    "@prisma/client": "6.19.3",
    "ai": "^6.0.277",
    "hono": "^4.9.8",
    "pg": "^8.16.3",
    "prisma": "6.19.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
