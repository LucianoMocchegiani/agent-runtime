# Copiar como .env para desarrollo local: cp .env.example .env
# En desarrollo, DATABASE_URL apunta al puerto publicado por Docker en localhost.

PORT=3030
DATABASE_URL=postgresql://agent:agent@localhost:5435/memory?schema=public

# Requerida para cifrar la configuración persistida. Generar con: openssl rand -hex 32
# Conservarla: cambiarla o perderla impide descifrar la configuración guardada.
RUNTIME_CONFIG_ENCRYPTION_KEY=

# Credenciales Basic del administrador local de recuperación (por defecto admin/admin).
# Cambialas antes de exponer Runtime, aunque el proveedor de auth externo esté configurado.
RUNTIME_ADMIN_USERNAME=admin
RUNTIME_ADMIN_PASSWORD=admin

# Opcional: habilita delegaciones. Clave distinta, estable y compartida entre réplicas.
# DELEGATION_PAYLOAD_ENCRYPTION_KEY=

# Opcionales para UIs externas que usan el SDK; separados por coma.
# La UI nativa servida por Runtime no necesita CORS.
# CORS_ORIGIN=https://mi-frontend.example.com
# CORS_APP_DOMAIN=example.com

# OAuth de MCP: registrar este callback en cada authorization server.
# MCP_OAUTH_REDIRECT_URI=http://localhost:3030/oauth/mcp/callback
# Clave independiente de 32 bytes (openssl rand -hex 32).
# MCP_OAUTH_ENCRYPTION_KEY=
# Solo si la UI está en otro origen (por ejemplo Vite):
# MCP_OAUTH_UI_REDIRECT_URL=http://localhost:5173/

# Opcional: desactivar la UI nativa (por defecto está habilitada).
# UI_ENABLED=false
