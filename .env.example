# Copiar a agent-runtime/.env (no se commitea).
# Compose carga este archivo en la API; en dev lo leen API y memory-mcp.

NODE_ENV=development
PORT=3010

# Solo deploy/docker-compose.yml (imágenes de ghcr.io): versión fija en vez de latest.
# AGENT_RUNTIME_VERSION=0.1.0

# PostgreSQL compartido por API y Memory MCP. Compose reemplaza localhost por postgres.
DATABASE_URL=postgresql://agent:agent@localhost:5433/memory?schema=public
# Obligatoria: generar una clave estable con `openssl rand -hex 32`.
# No cambiarla mientras exista configuración cifrada guardada.
RUNTIME_CONFIG_ENCRYPTION_KEY=

# Token Bearer administrativo para uso automatizado/CLI. No enviarlo al navegador.
# RUNTIME_CONFIG_ADMIN_TOKEN=
# Primer acceso clásico, activo solo mientras RUNTIME_CONFIG_ADMIN_USERS esté vacío.
# Valores iniciales: admin/admin. Cambiar antes de exponer el servicio.
# RUNTIME_CONFIG_BOOTSTRAP_USER=admin
# RUNTIME_CONFIG_BOOTSTRAP_PASSWORD=admin
# Identidades con acceso a la UI administrativa (userId o email separados por coma).
# RUNTIME_CONFIG_ADMIN_USERS=admin@example.com,usr_abc123

# Opcional: solo hace falta para habilitar embeddings desde runtime.config.
# Secreto compartido por API y Memory MCP; generarlo distinto de la clave de cifrado y del token admin.
# RUNTIME_CONFIG_INTERNAL_TOKEN=

# Memory MCP. La API conecta por URL (Compose la pisa con http://memory-mcp:3012/mcp).
MEMORY_MCP_URL=http://localhost:3012/mcp
# Lo lee memory-mcp en dev. Host default 127.0.0.1; no exponerlo a la red.
MEMORY_MCP_PORT=3012
# MEMORY_MCP_HOST=127.0.0.1

# Introspección del huésped. Cualquier sistema con /auth/me.
AUTH_INTROSPECT_URL=http://api:3001/auth/me
AUTH_MAPPING={"userId":"userId","email":null,"name":null}

# UI nativa (apps/ui) servida por el runtime en / (mismo origen, sin CORS).
# false = solo API (el huésped usa su propia UI con agent-runtime-client).
# UI_ENABLED=true
# Carpeta del build. Default: apps/ui/dist (npm run build en la raíz).
# UI_DIR=

# Orígenes de UIs externas (huéspedes con el SDK), separados por coma. La UI nativa no lo necesita.
CORS_ORIGIN=http://localhost:3001,http://localhost:3002,http://demo.localhost:3002
# Tunnel: https://{slug}.dominio y el apex (igual que Nest).
# CORS_APP_DOMAIN=faciliter.xyz

# En configuración nueva, runtime.config se crea automáticamente con defaults mínimos:
# sin proveedor de IA, MCP ni embeddings. Prompt y límites del chat tienen defaults seguros.
# Añadí proveedores, MCP y embeddings desde Administración → Configuración del runtime.
# DATABASE_URL y RUNTIME_CONFIG_ENCRYPTION_KEY son obligatorios para persistirla cifrada.

# Si corrés agent-runtime en el host contra el huésped en Docker:
# AUTH_INTROSPECT_URL=http://localhost:3001/auth/me
