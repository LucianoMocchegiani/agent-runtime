# Copiar a agent-runtime/.env (no se commitea).
# Compose carga este archivo solo en `agent-runtime` (API). En dev (npm run dev) lo leen API y memory-mcp.
# Cero GYMBRO_*: otra plataforma = otras URLs, misma imagen.

NODE_ENV=development
PORT=3010

# Solo deploy/docker-compose.yml (imágenes de ghcr.io): versión fija en vez de latest.
# AGENT_RUNTIME_VERSION=0.1.0

# Database del Memory MCP (solo la usa memory-mcp; la API no tiene database). Compose la pisa con host `postgres`.
DATABASE_URL=postgresql://agent:agent@localhost:5433/memory?schema=public

# MCPs configurados. JSON {"nombre":{"url":"...","auth":"...","headers":{...},"optional":false}}.
# auth: URL de introspección del MCP o null sin auth (con auth se reenvía el Bearer del usuario).
# headers: fijos del servidor (ej. secreto de un MCP propio); nunca pasan por el navegador.
# optional: true = si no conecta, el turno sigue sin sus tools; false (default) = 502.
# Tools expuestas al modelo como <nombre>__<tool>. MCP en el host (fuera de Docker): http://host.docker.internal:<puerto>/mcp
# MCP_CONFIG={"pc":{"url":"http://host.docker.internal:3020/mcp","auth":null,"headers":{"Authorization":"Bearer <PC_MCP_TOKEN>"},"optional":true}}
# Legacy (sin auth por MCP): MCP_URLS=http://mcp:3011/mcp

# Memory MCP. La API conecta por URL (Compose la pisa con http://memory-mcp:3012/mcp).
# Reemplazable por cualquier MCP que exponga las tools de agent-runtime-memory-contract.
MEMORY_MCP_URL=http://localhost:3012/mcp
# Lo lee memory-mcp en dev. Host default 127.0.0.1: no tiene auth propia, no exponerlo a la red.
MEMORY_MCP_PORT=3012
# MEMORY_MCP_HOST=127.0.0.1

# Introspección del huésped. Cualquier sistema con /auth/me.
AUTH_INTROSPECT_URL=http://api:3001/auth/me
AUTH_MAPPING={"userId":"userId","email":null,"name":null}

# Modelos de IA. Una línea JSON (env_file no admite multilínea).
# {"default":"proveedor/modelo","providers":{"<proveedor>":{"apiKey":"...","models":["..."],"contextWindows":{"<modelo>":128000}}}}
#   providers: openrouter | openai. Sin apiKey o con replace-me = deshabilitado.
#   models: ids del proveedor que ofrece el selector (OpenAI sin prefijo; OpenRouter con slug).
#   default: id completo "proveedor/modelo" (estilo opencode); debe ser de un proveedor habilitado.
# contextWindows: ventana total en tokens, opcional por id exacto del modelo dentro de cada proveedor.
# Si falta para el modelo elegido, se usa CHAT_CONTEXT_TOKENS como fallback.
# El cliente elige por mensaje con `model` (ver GET /v1/models).
# Compose: `restart` no recarga env_file. Tras editar, recreá:
#   docker compose up -d --force-recreate agent-runtime
AI_CONFIG={"default":"openai/gpt-4.1-mini","providers":{"openai":{"apiKey":"replace-me","models":["gpt-4.1-mini","gpt-4.1"]},"openrouter":{"apiKey":"replace-me","models":["openai/gpt-4.1-mini","anthropic/claude-sonnet-4"]}}}

# Búsqueda semántica de Memory. La configuración la usa memory-mcp, no agent-runtime.
# Adapter OpenAI-compatible; el modelo debe devolver vectores de 1536 dimensiones.
# Con OpenAI, text-embedding-3-small cumple ese requisito. Al configurarla,
# los documentos pendientes se procesan en background y searchMemory pasa a modo híbrido.
MEMORY_EMBEDDING_CONFIG={"apiKey":"replace-me","baseUrl":"https://api.openai.com/v1","model":"text-embedding-3-small"}

# UI nativa (apps/ui) servida por el runtime en / (mismo origen, sin CORS).
# false = solo API (el huésped usa su propia UI con agent-runtime-client).
# UI_ENABLED=true
# Carpeta del build. Default: apps/ui/dist (npm run build en la raíz).
# UI_DIR=

# Orígenes de UIs externas (huéspedes con el SDK), coma-separados. La UI nativa no lo necesita.
CORS_ORIGIN=http://localhost:3001,http://localhost:3002,http://demo.localhost:3002
# Tunnel: https://{slug}.dominio y el apex (igual que Nest).
# CORS_APP_DOMAIN=faciliter.xyz

CHAT_SYSTEM_PROMPT=Hablá en español. Usá las tools. No inventes ids.

# Presupuesto total de contexto y generación. La estimación de entrada es aproximada (chars/4).
# Cada proveedor/modelo puede sobrescribir CHAT_CONTEXT_TOKENS con AI_CONFIG.providers.<proveedor>.contextWindows.
# Se descuentan CHAT_RESPONSE_TOKENS y CHAT_CONTEXT_SAFETY_TOKENS antes de incluir el historial.
# CHAT_CONTEXT_TOKENS=10000
# Máximo de mensajes user/assistant históricos al iniciar el turno (default 20; no incluye system, tools disponibles ni pasos de tools en curso).
# CHAT_CONTEXT_MESSAGES=20
# CHAT_RESPONSE_TOKENS=2048
# CHAT_CONTEXT_SAFETY_TOKENS=512
# CHAT_MAX_TOOL_STEPS=8
# Resumen persistente: se crea cuando el recorte deja turnos antiguos fuera del contexto.
# CHAT_SUMMARIES_ENABLED=true
# CHAT_SUMMARY_TOKENS=300

# Debug: registra cada solicitud enviada al proveedor (system, mensajes y tools).
# Puede incluir datos privados de la conversación/resultados de tools; desactivarlo al terminar.
# Los bytes de imágenes y sus query strings se omiten/redactan.
# LLM_TRACE_REQUESTS=false

# Si corrés agent-runtime en el host contra el huésped en Docker:
# AUTH_INTROSPECT_URL=http://localhost:3001/auth/me
# LLM_TRACE_REQUESTS=false

# Si corrés agent-runtime en el host contra el huésped en Docker:
# AUTH_INTROSPECT_URL=http://localhost:3001/auth/me